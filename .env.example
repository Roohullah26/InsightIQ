# InsightIQ local development configuration template.
# Copy to .env locally only when you choose to configure file-based settings.
# Never put real secrets in this template.

INSIGHTIQ_APP_NAME=InsightIQ API
INSIGHTIQ_ENVIRONMENT=development
INSIGHTIQ_DEBUG=false
INSIGHTIQ_API_V1_PREFIX=/api/v1
INSIGHTIQ_MAX_UPLOAD_SIZE_BYTES=10485760
INSIGHTIQ_MAX_ROWS_LIMIT=100000
INSIGHTIQ_MAX_COLUMNS_LIMIT=200

# Optional AI / LLM configuration
INSIGHTIQ_AI_ENABLED=false
INSIGHTIQ_AI_MODEL=gemini-2.5-flash
# INSIGHTIQ_GEMINI_API_KEY=your-api-key-here

