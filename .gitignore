# ---- Python bytecode / caches ----
__pycache__/
*.py[cod]
*$py.class

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Environment variables & local secrets (keep the example template) ----
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---- Test, coverage & tooling caches ----
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/
.pytype/

# ---- Packaging / build output ----
build/
dist/
*.egg-info/
.eggs/

# ---- Generated data & local artifacts (root-anchored; app source is never excluded) ----
/data/
/uploads/
/artifacts/
/logs/
*.log
*.sqlite
*.sqlite3
*.db

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Editor / OS files ----
.idea/
.vscode/
.DS_Store
Thumbs.db
